# ============================================================
# PREPARAR DATOS
# ============================================================

def preparar_datos(df):

    df = df.copy()

    df["Deposito"] = pd.to_numeric(
        df["Deposito"],
        errors="coerce"
    )

    df = df.dropna(
        subset=["Usuario", "Deposito"]
    )

    return df


# ============================================================
# ICF
# ============================================================

def calcular_icf(df):

    resultados = []

    for usuario, grupo in df.groupby("Usuario"):

        total = grupo["Deposito"].sum()

        cantidad = len(grupo)

        promedio = grupo["Deposito"].mean()

        # ----------------------------------------
        # Ahorro = 40%
        # ----------------------------------------

        ahorro = min(
            total / 40000 * 100,
            100
        )

        # ----------------------------------------
        # Frecuencia = 30%
        # ----------------------------------------

        frecuencia = min(
            cantidad / 5 * 100,
            100
        )

        # ----------------------------------------
        # Promedio = 30%
        # ----------------------------------------

        promedio_puntos = min(
            promedio / 20000 * 100,
            100
        )

        # ----------------------------------------
        # ICF
        # ----------------------------------------

        icf = (
            ahorro * 0.40
            + frecuencia * 0.30
            + promedio_puntos * 0.30
        )

        # ----------------------------------------
        # Clasificación
        # ----------------------------------------

        if icf < 40:

            nivel = "Bajo"

        elif icf < 70:

            nivel = "Medio"

        elif icf < 90:

            nivel = "Alto"

        else:

            nivel = "Excelente"

        resultados.append({

            "Usuario": usuario,

            "Ahorro total": total,

            "Depósitos": cantidad,

            "Promedio depósito": round(
                promedio,
                2
            ),

            "ICF": round(
                icf,
                2
            ),

            "Nivel": nivel

        })

    return pd.DataFrame(resultados)


# ============================================================
# DETECTAR IDIOMA
# ============================================================

def detectar_idioma(audio_bytes):

    reconocedor = sr.Recognizer()

    archivo = tempfile.NamedTemporaryFile(
        delete=False,
        suffix=".wav"
    )

    ruta = archivo.name

    try:

        archivo.write(audio_bytes)

        archivo.close()

        with sr.AudioFile(ruta) as fuente:

            audio = reconocedor.record(
                fuente
            )

        # ----------------------------------------------------
        # Intentamos detectar el idioma probando varios.
        # ----------------------------------------------------

        idiomas = {

            "es": "es-CO",

            "en": "en-US",

            "pt": "pt-BR",

            "fr": "fr-FR",

            "de": "de-DE",

            "it": "it-IT"

        }

        resultados = []

        for codigo, idioma_google in idiomas.items():

            try:

                texto = reconocedor.recognize_google(
                    audio,
                    language=idioma_google
                )

                if texto:

                    resultados.append(
                        (
                            codigo,
                            texto
                        )
                    )

            except:

                pass

        # ----------------------------------------------------
        # Si encontró resultados, elegimos el primero.
        # ----------------------------------------------------

        if resultados:

            return resultados[0][0], resultados[0][1]

        return "es", ""

    except sr.UnknownValueError:

        return "es", ""

    except sr.RequestError:

        raise Exception(
            "No fue posible conectarse al "
            "servicio de reconocimiento de voz."
        )

    finally:

        if os.path.exists(ruta):

            os.remove(ruta)


