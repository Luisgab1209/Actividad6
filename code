# ============================================================
# GENERAR AUDIO EN EL MISMO IDIOMA
# ============================================================

def generar_audio(texto, idioma):

    idiomas_gtts = {

        "es": "es",

        "en": "en",

        "pt": "pt",

        "fr": "fr",

        "de": "de",

        "it": "it"

    }

    idioma_tts = idiomas_gtts.get(
        idioma,
        "es"
    )

    archivo = tempfile.NamedTemporaryFile(
        delete=False,
        suffix=".mp3"
    )

    ruta = archivo.name

    archivo.close()

    try:

        tts = gTTS(
            text=texto,
            lang=idioma_tts,
            slow=False
        )

        tts.save(ruta)

        with open(
            ruta,
            "rb"
        ) as f:

            return f.read()

    finally:

        if os.path.exists(ruta):

            os.remove(ruta)


